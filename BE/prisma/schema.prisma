// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  buyer
  seller
  admin
}

enum KycStatus {
  not_submitted
  pending
  verified
  rejected
}

enum PlanType {
  creator
  startup
  enterprise
}

enum PlatformFeeMode {
  seller
  buyer
}

enum DocumentType {
  pan
  aadhaar
}

enum PennyDropStatus {
  pending
  success
  failed
}

enum PayoutStatus {
  pending
  processing
  completed
  failed
}

enum OrderStatus {
  pending
  completed
  refunded
}

enum DeliveryType {
  download
  external_link
  manual
}

enum DeliveryStatus {
  pending
  delivered
}

model User {
  id                           String       @id @default(uuid()) @db.Uuid
  email                        String       @unique @db.VarChar(255)
  passwordHash                 String       @map("password_hash") @db.VarChar(255)
  name                         String       @db.VarChar(255)
  avatarUrl                    String?      @map("avatar_url")
  role                         UserRole     @default(buyer)
  isSeller                     Boolean      @default(false) @map("is_seller")
  storeUrl                     String?      @unique @map("store_url") @db.VarChar(100)
  planType                     PlanType     @default(creator) @map("plan_type")
  kycStatus                    KycStatus    @default(not_submitted) @map("kyc_status")
  onboardingComplete           Boolean      @default(false) @map("onboarding_complete")
  emailVerified                Boolean      @default(false) @map("email_verified")
  emailVerificationToken       String?      @map("email_verification_token") @db.VarChar(255)
  emailVerificationExpiresAt   DateTime?    @map("email_verification_expires_at")
  passwordResetToken           String?      @map("password_reset_token") @db.VarChar(255)
  passwordResetExpiresAt       DateTime?    @map("password_reset_expires_at")
  followersCount               Int          @default(0) @map("followers_count")
  totalProducts                Int          @default(0) @map("total_products")
  totalSales                   Int          @default(0) @map("total_sales")
  totalRevenue                 Decimal      @default(0) @map("total_revenue") @db.Decimal(10, 2)
  isActive                     Boolean      @default(true) @map("is_active")
  createdAt                    DateTime     @default(now()) @map("created_at")
  updatedAt                    DateTime     @updatedAt @map("updated_at")
  lastLoginAt                  DateTime?    @map("last_login_at")

  // Relations
  storefront    Storefront?
  sessions      Session[]
  kyc           Kyc?
  payouts       Payout[]
  sellerOrders  Order[]      @relation("SellerOrders")
  buyerOrders   Order[]      @relation("BuyerOrders")

  @@index([email])
  @@index([storeUrl])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Storefront {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @unique @map("user_id") @db.Uuid
  storeUrl          String?         @unique @map("store_url") @db.VarChar(100)
  storeName         String?         @map("store_name") @db.VarChar(255)
  description       String?
  profileImageUrl   String?         @map("profile_image_url")
  coverImageUrl     String?         @map("cover_image_url")
  tagline           String?
  bio               String?
  themeId           String          @default("modern") @map("theme_id") @db.VarChar(50)
  primaryColor      String          @default("#6366f1") @map("primary_color") @db.VarChar(7)
  fontFamily        String          @default("Inter") @map("font_family") @db.VarChar(100)
  isPublished       Boolean         @default(false) @map("is_published")
  platformFeeMode   PlatformFeeMode @default(buyer) @map("platform_fee_mode")
  // Payment Information (Bank details are stored in KYC table)
  paymentMethod     String?         @map("payment_method") @db.VarChar(20)
  upiId             String?         @map("upi_id") @db.VarChar(255)
  // Contact & Social
  contactEmail      String?         @map("contact_email") @db.VarChar(255)
  contactPhone      String?         @map("contact_phone") @db.VarChar(20)
  contactWhatsapp   String?         @map("contact_whatsapp") @db.VarChar(20)
  socialInstagram   String?         @map("social_instagram") @db.VarChar(255)
  socialTwitter     String?         @map("social_twitter") @db.VarChar(255)
  socialYoutube     String?         @map("social_youtube") @db.VarChar(255)
  socialWebsite     String?         @map("social_website") @db.VarChar(255)
  // Advanced
  customCss         String?         @map("custom_css")
  customDomain      String?         @map("custom_domain") @db.VarChar(255)
  seoTitle          String?         @map("seo_title") @db.VarChar(255)
  seoDescription    String?         @map("seo_description")
  seoKeywords       String?         @map("seo_keywords")
  analyticsId       String?         @map("analytics_id") @db.VarChar(100)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([storeUrl])
  @@map("storefronts")
}

model Product {
  id            String    @id @default(uuid()) @db.Uuid
  storefrontId  String    @map("storefront_id") @db.Uuid
  title         String    @db.VarChar(255)
  description   String?   @db.Text
  price         Decimal   @db.Decimal(10, 2)
  
  // File storage fields
  fileUrl       String    @map("file_url")  // For Drive: stores driveFileId; For legacy: stores Cloudinary URL
  thumbnailUrl  String?   @map("thumbnail_url")  // Cloudinary thumbnail URL
  
  // Google Drive specific fields
  driveFileId     String?  @map("drive_file_id")  // Google Drive file ID
  driveFileName   String?  @map("drive_file_name")  // Original filename in Drive
  
  // Cloudinary tracking (for thumbnails)
  thumbnailPublicId  String? @map("thumbnail_public_id")  // Cloudinary public ID for thumbnail
  
  seoTitle      String?   @map("seo_title") @db.VarChar(255)
  seoKeywords   String?   @map("seo_keywords") @db.VarChar(500)
  isActive      Boolean   @default(true) @map("is_active")
  stock         Int?
  downloads     Int       @default(0)
  views         Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  storefront Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([storefrontId])
  @@index([isActive])
  @@index([createdAt])
  @@map("products")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  token        String   @unique @db.VarChar(255)
  refreshToken String?  @map("refresh_token") @db.VarChar(500)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(1000)
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

model Kyc {
  id                    String          @id @default(uuid()) @db.Uuid
  userId                String          @unique @map("user_id") @db.Uuid
  documentType          DocumentType    @map("document_type")
  panNumber             String?         @map("pan_number") @db.VarChar(10)
  aadhaarNumber         String?         @map("aadhaar_number") @db.VarChar(12)
  documentFileUrl       String?         @map("document_file_url")
  accountHolderName     String          @map("account_holder_name") @db.VarChar(255)
  accountNumber         String          @map("account_number") @db.VarChar(20)
  ifscCode              String          @map("ifsc_code") @db.VarChar(11)
  bankName              String          @map("bank_name") @db.VarChar(255)
  verificationStatus    KycStatus       @default(pending) @map("verification_status")
  pennyDropStatus       PennyDropStatus @default(pending) @map("penny_drop_status")
  rejectionReason       String?         @map("rejection_reason")
  verifiedAt            DateTime?       @map("verified_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([verificationStatus])
  @@map("kyc")
}

model Payout {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  amount          Decimal       @db.Decimal(10, 2)
  status          PayoutStatus  @default(pending)
  transactionId   String?       @map("transaction_id") @db.VarChar(255)
  utrNumber       String?       @map("utr_number") @db.VarChar(100)
  failureReason   String?       @map("failure_reason")
  processedAt     DateTime?     @map("processed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("payouts")
}

model Order {
  id                  String          @id @default(uuid()) @db.Uuid
  sellerId            String          @map("seller_id") @db.Uuid
  buyerId             String?         @map("buyer_id") @db.Uuid
  productId           String          @map("product_id") @db.Uuid
  productTitle        String          @map("product_title") @db.VarChar(255)
  productThumbnail    String?         @map("product_thumbnail")
  productDescription  String?         @map("product_description") @db.Text
  buyerEmail          String          @map("buyer_email") @db.VarChar(255)
  buyerName           String          @map("buyer_name") @db.VarChar(255)
  buyerPhone          String?         @map("buyer_phone") @db.VarChar(20)
  buyerGstin          String?         @map("buyer_gstin") @db.VarChar(15)
  amount              Decimal         @db.Decimal(10, 2)
  gstAmount           Decimal         @map("gst_amount") @db.Decimal(10, 2)
  platformFee         Decimal?        @map("platform_fee") @db.Decimal(10, 2)
  totalAmount         Decimal         @map("total_amount") @db.Decimal(10, 2)
  status              OrderStatus     @default(pending)
  deliveryType        DeliveryType    @map("delivery_type")
  deliveryStatus      DeliveryStatus? @map("delivery_status")
  externalUrl         String?         @map("external_url")
  paymentMethod       String?         @map("payment_method") @db.VarChar(50)
  paymentId           String?         @map("payment_id") @db.VarChar(255)
  downloadCount       Int             @default(0) @map("download_count")
  maxDownloads        Int             @default(5) @map("max_downloads")
  downloadLink        String?         @map("download_link")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  seller        User          @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer         User?         @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: SetNull)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  downloadLogs  DownloadLog[]

  @@index([sellerId])
  @@index([buyerId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
  @@index([buyerEmail])
  @@map("orders")
}

model DownloadLog {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  productTitle  String   @map("product_title") @db.VarChar(255)
  buyerName     String   @map("buyer_name") @db.VarChar(255)
  buyerEmail    String   @map("buyer_email") @db.VarChar(255)
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.VarChar(500)
  downloadedAt  DateTime @default(now()) @map("downloaded_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([downloadedAt])
  @@map("download_logs")
}
