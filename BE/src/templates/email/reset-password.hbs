<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Your Password - {{platformName}}</title>
</head>
<body style="margin: 0; padding: 0; font-family: Arial, sans-serif; background-color: #f3f4f6;">
  <table role="presentation" style="width: 100%; border-collapse: collapse;">
    <tr>
      <td align="center" style="padding: 40px 0;">
        <table role="presentation" style="width: 600px; border-collapse: collapse; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2 4px rgba(0,0,0,0.1);">
          <!-- Header -->
          <tr>
            <td style="background-color: #6366f1; padding: 30px 40px; text-align: center;">
              <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: bold;">{{platformName}}</h1>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding: 40px;">
              <h2 style="margin: 0 0 20px; color: #1f2937; font-size: 24px;">Hi {{name}},</h2>

              <p style="margin: 0 0 20px; color: #374151; font-size: 16px; line-height: 1.6;">
                We received a request to reset your password for your {{platformName}} account.
              </p>

              <p style="margin: 0 0 30px; color: #374151; font-size: 16px; line-height: 1.6;">
                Click the button below to reset your password:
              </p>

              <!-- Button -->
              <div style="margin: 30px 0; text-align: center;">
                <a href="{{resetUrl}}" style="display: inline-block; padding: 16px 40px; background-color: #6366f1; color: #ffffff; text-decoration: none; border-radius: 6px; font-size: 16px; font-weight: 600;">
                  Reset Password
                </a>
              </div>

              <p style="margin: 30px 0 20px; color: #6b7280; font-size: 14px;">
                ⏱️ This link will expire in {{expiryHours}} hour(s).
              </p>

              <p style="margin: 0 0 20px; color: #374151; font-size: 16px; line-height: 1.6;">
                If the button doesn't work, copy and paste this link into your browser:
              </p>

              <div style="background-color: #f9fafb; padding: 15px; border-radius: 6px; border: 1px solid #e5e7eb; word-break: break-all; margin: 20px 0;">
                <a href="{{resetUrl}}" style="color: #6366f1; text-decoration: none; font-size: 14px;">{{resetUrl}}</a>
              </div>

              <div style="background-color: #fef2f2; border-left: 4px solid #ef4444; padding: 15px; margin: 30px 0; border-radius: 4px;">
                <p style="margin: 0; color: #991b1b; font-size: 14px; font-weight: 600;">
                  ⚠️ Security Notice
                </p>
                <p style="margin: 10px 0 0; color: #7f1d1d; font-size: 14px; line-height: 1.6;">
                  If you didn't request a password reset, please ignore this email. Your password will remain unchanged. For security, we recommend changing your password if you think someone else has access to your account.
                </p>
              </div>

              <p style="margin: 30px 0 0; padding-top: 30px; border-top: 1px solid #e5e7eb; color: #9ca3af; font-size: 14px; line-height: 1.6;">
                Need help? Contact us at <a href="mailto:support@genzaic.com" style="color: #6366f1; text-decoration: none;">support@genzaic.com</a>
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color: #f9fafb; padding: 30px 40px; text-align: center; border-top: 1px solid #e5e7eb;">
              <p style="margin: 0 0 10px; color: #6b7280; font-size: 14px;">
                © 2025 {{platformName}}. All rights reserved.
              </p>
              <p style="margin: 0; font-size: 12px;">
                <a href="{{platformUrl}}" style="color: #6366f1; text-decoration: none; margin: 0 10px;">Website</a>
                <span style="color: #d1d5db;">|</span>
                <a href="{{platformUrl}}/about" style="color: #6366f1; text-decoration: none; margin: 0 10px;">About</a>
                <span style="color: #d1d5db;">|</span>
                <a href="{{platformUrl}}/disclaimer" style="color: #6366f1; text-decoration: none; margin: 0 10px;">Disclaimer</a>
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
