# Database (Neon PostgreSQL recommended)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-run-openssl-rand-base64-32"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ImageKit
IMAGEKIT_PUBLIC_KEY="your_imagekit_public_key"
IMAGEKIT_PRIVATE_KEY="your_imagekit_private_key"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="noreply@yourdomain.com"

# Google AI (for product extraction)
GOOGLE_AI_API_KEY="your_google_ai_key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="your_imagekit_public_key"
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"

RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx

# ─── Notifications (Firebase Cloud Messaging) ─────────────────────────────────
# Server: base64-encoded service-account JSON. Generate in Firebase console:
#   Project Settings → Service Accounts → Generate new private key → base64 -w0 file.json
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Client (public): from Firebase console Web app config. Safe to expose.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Web Push public VAPID key: Project Settings → Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# ─── Cron auth (Vercel cron secret) ───────────────────────────────────────────
# Random 32+ char string. Vercel sends as `Authorization: Bearer <value>` on cron runs.
CRON_SECRET=""

# ─── Feature flags ────────────────────────────────────────────────────────────
# Set to "true" to show the browser-push opt-in banner after 30s of activity.
NEXT_PUBLIC_NOTIFICATIONS_OPT_IN_ENABLED="false"